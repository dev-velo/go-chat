# Copy to infra/terraform.tfvars;
# Use an OpenAI API key for the provider/model below. Never commit the populated file.
# For Anthropic, set llm_provider = "anthropic", use a Claude model ID and an Anthropic key.
llm_provider = "openai"
llm_model    = "gpt-4o-mini"

create_llm_api_key_ssm_parameter = true
llm_api_key                      = "YOUR_OPENAI_API_KEY"
