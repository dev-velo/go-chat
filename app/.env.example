# Required
STORE_BACKEND = memory   # memory | s3
LLM_PROVIDER  = fake     # fake | anthropic | openai
LLM_MODEL     = fake     # fake | real llm model name
LLM_API_KEY   = fake_key # fake | key for whichever provider is selected.

SSM_FETCH_KEY = false              # true | false - if true, fetch LLM_API_KEY from AWS SSM Parameter Store instead of using LLM_API_KEY directly.
SSM_KEY_NAME  = /myapp/llm_api_key # Optional - if SSM_FETCH_KEY is true, this is the name of the parameter in AWS SSM Parameter Store to fetch the LLM_API_KEY from.

# Optional
PORT     = 8080
GIN_MODE = debug # debug | release | test
