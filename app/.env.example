# Copy this file to .env.local when doing local docker development.
# Required

STORE_BACKEND = memory   # memory | s3
APP_USER_NAME = myuser # Required for memory: local sign-in username.
APP_USER_PASS = mypass # Required for memory: local sign-in password.

# If STORE_BACKEND is s3, the following are required:
#STORE_BACKEND = s3
#SSM_KEY_NAME  = /myapp/llm_api_key # Required for s3: fetch the LLM API key from this parameter.
#S3_BUCKET_NAME = my-bucket # Optional - if STORE_BACKEND is s3, this is the name of the S3 bucket to use.
#S3_BUCKET_PATH = my-path   # Optional - if STORE_BACKEND is s3, this is the path within the S3 bucket to use.
#SSM_USER_KEY_NAME = /myapp/app_user_name # Required for s3; direct credentials are ignored.
#SSM_PASS_KEY_NAME = /myapp/app_user_pass # Required for s3.

# Support multiple LLM providers, only had access to openai key so thats been fully tested end to end.
# Suppoer for anthropic is in place, but not tested. Fake is a mock provider for testing and development.
LLM_PROVIDER  = fake     # fake | anthropic | openai
LLM_MODEL     = fake     # fake | real llm model name
LLM_API_KEY   = fake_key # fake | key for whichever provider is selected.

# Optional
PORT     = 8080
GIN_MODE = debug # debug | release | test
